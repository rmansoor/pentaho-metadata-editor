<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.pentaho</groupId>
    <artifactId>pentaho-ce-jar-parent-pom</artifactId>
    <version>9.3.0.0-SNAPSHOT</version>
  </parent>
  <groupId>pentaho</groupId>
  <artifactId>pentaho-metadata-editor-parent</artifactId>
  <version>9.3.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>${project.artifactId}</name>
  <description></description>
  <url>http://www.pentaho.com</url>

  <modules>
    <module>editor</module>
    <module>assemblies</module>
  </modules>

  <scm>
    <connection>scm:git:git@github.com:pentaho/pentaho-metadata-editor.git</connection>
    <developerConnection>scm:git:git@github.com:pentaho/pentaho-metadata-editor.git</developerConnection>
    <url>https://github.com/pentaho/pentaho-metadata-editor</url>
  </scm>

  <properties>
    <blueprints-core.version>2.6.0</blueprints-core.version>
    <com.sun.jersey.version>1.19.1</com.sun.jersey.version>
    <commands.version>3.3.0-I20070605-0010</commands.version>
    <commons-collections.version>3.2.2</commons-collections.version>
    <commons-configuration.version>1.9</commons-configuration.version>
    <commons-io.version>2.2</commons-io.version>
    <commons-lang.version>2.6</commons-lang.version>
    <edtftpj.version>2.1.0</edtftpj.version>
    <ehcache.version>1.1</ehcache.version>
    <hibernate.version>3.2.2.ga</hibernate.version>
    <javadbf.version>0.4.0</javadbf.version>
    <javassist.version>3.20.0-GA</javassist.version>
    <jface.version>3.22.0</jface.version>
    <js.version>1.7R3</js.version>
    <jsch.version>0.1.54</jsch.version>
    <jsr311-api.version>1.1.1</jsr311-api.version>
    <jug-lgpl.version>2.0.0</jug-lgpl.version>
    <junit.version>4.4</junit.version>
    <jxl.version>2.5.7</jxl.version>
    <license.header.file>license/templates/licenseHeader.txt</license.header.file>
    <license.inception.year>2002</license.inception.year>
    <license-maven-plugin.version>2.3</license-maven-plugin.version>
    <livetribe-jsr223.version>2.0.6</livetribe-jsr223.version>
    <mail.version>1.6.1</mail.version>
    <mimepull.version>1.9.3</mimepull.version>
    <mockito-all.version>1.8.0</mockito-all.version>
    <nbmdr.version>200507110943-custom</nbmdr.version>
    <net.sf.saxon.version>9.1.0.8</net.sf.saxon.version>
    <org.eclipse.equinox.common.version>3.3.0-v20070426</org.eclipse.equinox.common.version>
    <org.netbeans.version>200507110943</org.netbeans.version>
    <org.eclipse.swt.version>4.6</org.eclipse.swt.version>
    <pentaho-cwm.version>1.5.4</pentaho-cwm.version>
    <scannotation.version>1.0.2</scannotation.version>
    <snmp4j.version>1.9.3d</snmp4j.version>
    <trilead-ssh2.version>1.0.0-build215</trilead-ssh2.version>
    <core.commands.version>3.9.800</core.commands.version>
    <equinox.bidi.version>1.3.0</equinox.bidi.version>
    <equinox.common.version>3.14.0</equinox.common.version>
    <pentaho-connections.version>9.3.0.0-SNAPSHOT</pentaho-connections.version>
    <pdi.version>9.3.0.0-SNAPSHOT</pdi.version>
    <pentaho-reporting.version>9.3.0.0-SNAPSHOT</pentaho-reporting.version>
    <pentaho-metadata.version>9.3.0.0-SNAPSHOT</pentaho-metadata.version>
    <pentaho-vfs-browser.version>9.3.0.0-SNAPSHOT</pentaho-vfs-browser.version>
    <commons-xul.version>9.3.0.0-SNAPSHOT</commons-xul.version>
    <pentaho-karaf.version>9.3.0.0-SNAPSHOT</pentaho-karaf.version>
    <pentaho-osgi-bundles.version>9.3.0.0-SNAPSHOT</pentaho-osgi-bundles.version>
    <pdi-osgi-bridge.version>9.3.0.0-SNAPSHOT</pdi-osgi-bridge.version>
    <pentaho-metaverse.version>9.3.0.0-SNAPSHOT</pentaho-metaverse.version>
    <platform.version>9.3.0.0-SNAPSHOT</platform.version>
    <pentaho-mql-editor.version>9.3.0.0-SNAPSHOT</pentaho-mql-editor.version>
    <jakarta-annotaion-api.version>1.3.5</jakarta-annotaion-api.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>com.mycila</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>${license-maven-plugin.version}</version>
        <configuration>
          <header>${license.header.file}</header>
          <headerDefinitions>
            <headerDefinition>license/styles/javadoc_style_license_header.xml</headerDefinition>
          </headerDefinitions>
          <properties>
            <project.inceptionYear>${license.inception.year}</project.inceptionYear>
          </properties>
          <useDefaultExcludes>true</useDefaultExcludes>
          <includes>
            <include>src/main/java/**</include>
            <include>src/test/java/**</include>
            <include>src/it/java/**</include>
            <include>src/main/javascript/**</include>
            <include>src/test/javascript/**</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.swt</groupId>
      <artifactId>org.eclipse.swt.gtk.linux.x86</artifactId>
      <version>${org.eclipse.swt.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.swt</groupId>
      <artifactId>org.eclipse.swt.gtk.linux.x86_64</artifactId>
      <version>${org.eclipse.swt.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.swt</groupId>
      <artifactId>org.eclipse.swt.win32.win32.x86</artifactId>
      <version>${org.eclipse.swt.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.swt</groupId>
      <artifactId>org.eclipse.swt.win32.win32.x86_64</artifactId>
      <version>${org.eclipse.swt.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.swt</groupId>
      <artifactId>org.eclipse.swt.cocoa.macosx.x86_64</artifactId>
      <version>${org.eclipse.swt.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>pentaho-public</id>
      <name>Pentaho Public</name>
      <url>https://repo.orl.eng.hitachivantara.com/artifactory/pnt-mvn/</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>daily</updatePolicy>
      </releases>
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>interval:15</updatePolicy>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>pentaho-public-plugins</id>
      <name>Pentaho Public Plugins</name>
      <url>https://repo.orl.eng.hitachivantara.com/artifactory/pnt-mvn/</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <releases>
        <updatePolicy>never</updatePolicy>
      </releases>
    </pluginRepository>
  </pluginRepositories>

</project>
